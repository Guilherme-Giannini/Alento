# Copie para .env na VPS e preencha. Nunca versione o .env.
DOMINIO=alento.app.br
ADMIN_EMAIL=voce@exemplo.com
ALENTO_IMAGEM=ghcr.io/seu-usuario/alento:latest

POSTGRES_PASSWORD=troque-por-uma-senha-forte

# WhatsApp Cloud API (Meta) — empresa verificada + template "lembrete_sessao" aprovado
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE=lembrete_sessao

# Asaas (produção: https://api.asaas.com/v3 · sandbox: https://api-sandbox.asaas.com/v3)
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# E-mail transacional (Resend) — configure SPF, DKIM e DMARC no domínio
RESEND_API_KEY=

# Observabilidade (plano grátis)
SENTRY_DSN=

# Backup criptografado (deploy/backup.sh)
BACKUP_GPG_SENHA=troque-por-outra-senha-forte
RCLONE_DESTINO=r2:alento-backups
