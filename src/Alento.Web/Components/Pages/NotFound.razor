@page "/not-found"
@attribute [ExcludeFromInteractiveRouting]
@layout SiteLayout

<PageTitle>Página não encontrada · Alento</PageTitle>

<main class="doc">
    <div class="container estreito centro">
        <a href="/" class="logo" style="justify-content:center;margin-bottom:24px"><Logo /> Alento</a>
        <h1>Página não encontrada</h1>
        <p class="lead" style="margin:0 auto 24px">O endereço pode ter mudado ou o link de agendamento foi digitado errado.</p>
        <a href="/" class="btn-cta">Voltar ao início</a>
    </div>
</main>
